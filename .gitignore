# ── secrets ────────────────────────────────────────────────────────────────
# Real Zoho OAuth tokens, the RAG auth header and the LLM key live here.
# .env.example documents the keys without the values.
.env
*.pem
*.key
certs/

# ── data (1.3 GB) ──────────────────────────────────────────────────────────
# Measurement recordings: raw mic/ref audio plus per-chunk telemetry. Far too
# large for git, and they contain recorded voices. Every analysis that reads
# them names the files it expects, so they can be regenerated by running the
# demo with recording on.
recordings/

# ── model weights ──────────────────────────────────────────────────────────
# Fetched from the sherpa-onnx release; server/speech/denoise.py prints the
# exact command in its FileNotFoundError.
models/*.onnx

# ── runtime ────────────────────────────────────────────────────────────────
*.log
.*.pid
__pycache__/
*.py[cod]
.deps/
.ipynb_checkpoints/

# Machine-local tool config (absolute paths, session ids)
.claude/settings.local.json
